#!/bin/bash -l
# Run diffusion_http_server.py on an SCC GPU node and keep it alive as a long job.
#
# Submit from the repo root:
#   qsub -P <your_project> -v MODEL=/projectnb/.../model-Q8_0.gguf scripts/diffusion_http_server.qsub
#
# Overrides (comma-separated, via -v):
#   MODEL        GGUF path (required)
#   LLAMA_BIN    dir holding llama-diffusion-gemma-visual-server (default ./llama.cpp/build/bin)
#   PORT         default 0 -- OS picks a free port. Shared SCC nodes may already have a fixed
#                port like 8000 held by someone else's job, so don't hardcode this. The real,
#                bound port is printed to diffusion_http.log -- read it from there, not from
#                whatever you asked for.
#   CUDA_MODULE  default cuda/12.5
#
# Once it's running:
#   qstat -u $USER              # find the compute node
#   tail -f diffusion_http.log  # prints "serving on http://<hostname>:<port>" plus a ready-made
#                                # ssh -L tunnel command using the ACTUAL port
#
# Kill the job with `qdel <job-id>` when you're done -- it runs until h_rt or you stop it.

#$ -N diffusion_http
#$ -cwd
#$ -l gpus=1
#$ -l gpu_type=L40S
#$ -pe omp 4
#$ -l h_rt=12:00:00
#$ -j y
#$ -o diffusion_http.log

set -euo pipefail

: "${MODEL:?set MODEL=/path/to/model.gguf with qsub -v}"
LLAMA_BIN=${LLAMA_BIN:-$PWD/llama.cpp/build/bin}
PORT=${PORT:-0}
CUDA_MODULE=${CUDA_MODULE:-cuda/12.5}

module load gcc python3 "$CUDA_MODULE"
echo "host=$(hostname) gpu=$(nvidia-smi --query-gpu=name --format=csv,noheader) model=$MODEL"
# diffusion_http_server.py prints the actual bound port + tunnel command once it starts --
# that line is the source of truth, not $PORT above.

python3 scripts/diffusion_http_server.py \
    --model "$MODEL" \
    --server "$LLAMA_BIN/llama-diffusion-gemma-visual-server" \
    --host 0.0.0.0 \
    --port "$PORT"
